# ClipForge — example environment configuration
# Copy to `.env` and fill in real values. NEVER commit a real .env.

# ── Database ────────────────────────────────────────────────────────────────
# Prisma + SQLite. The file lives in <project>/db/ (see prisma/schema.prisma).
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ── LLM / AI provider ───────────────────────────────────────────────────────
# The z-ai-web-dev-sdk reads its credentials from the environment it ships
# with (ZAI_* variables / managed key). In local development the SDK's own
# mechanism usually works with no extra configuration. If your setup requires
# an explicit key, set it here and keep it OUT of git:
# ZAI_API_KEY=""

# ── Renderer mini-service (internal only) ───────────────────────────────────
# The ffmpeg-renderer listens on this port. It is explicitly bound to
# 127.0.0.1 (see mini-services/ffmpeg-renderer/index.ts) — never expose it.
# The Next.js proxy (src/app/api/render-proxy) is the only public boundary.
RENDERER_PORT=3003

# ── Internal renderer authentication (REQUIRED, server-side only) ──────────
# Shared secret between the Next.js proxy and the ffmpeg-renderer. EVERY
# Next.js → renderer request carries it (X-ClipForge-Internal-Token header);
# the renderer rejects missing/incorrect tokens with 401 BEFORE any FFmpeg
# work. This stops a malicious local webpage from driving the renderer via
# simple cross-origin POSTs to 127.0.0.1 (CORS does not prevent sending).
# NEVER expose it to the browser, client JS, logs, or public responses.
CLIPFORGE_RENDERER_TOKEN=change-me-in-local-development

# ── Media cache (downloaded YouTube sources + uploads) ─────────────────────
# Byte cap for the LRU media library and the render-artifact lifetime.
# Defaults live in src/lib/media-cache.ts / mini-services/ffmpeg-renderer.
# MEDIA_CACHE_MAX_BYTES=10737418240

# ── Daily usage soft limits (self-host escape hatches) ─────────────────────
# Per-kind daily caps. Invalid/negative values fall back to the default;
# 0 means UNLIMITED for that kind. Counters reset at UTC midnight.
# CLIPFORGE_DAILY_LIMIT_ANALYZE=200
# CLIPFORGE_DAILY_LIMIT_PREPARE=40
# CLIPFORGE_DAILY_LIMIT_RENDER=100
# CLIPFORGE_DAILY_LIMIT_TRANSCRIBE=120

# ── External tools (not env vars — document for self-hosters) ───────────────
# ffmpeg / ffprobe: required on PATH (renderer + probes).
# yt-dlp: optional; enables real metadata + captions + source download.
#   Resolved automatically from: /home/z/.venv/bin, ~/.local/bin,
#   /usr/local/bin, /usr/bin. Install: `pip install yt-dlp`.
